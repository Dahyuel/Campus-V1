# Campus LMS - Environment Template
# Copy this file to .env and fill in strong, unique secrets for every key.
# NEVER commit .env or credentials.txt to version control.

# Database (local Docker PostgreSQL)
DATABASE_URL=postgresql://campus:campus@localhost:5432/campus_db

# Redis (local Docker Redis)
REDIS_URL=redis://localhost:6379

# JWT secrets - generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_64
JWT_ACCESS_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_64
JWT_REFRESH_SECRET=CHANGE_ME_WITH_OPENSSL_RAND_BASE64_64

# Token TTLs
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

# Password hashing
BCRYPT_ROUNDS=12

# Server
PORT=4000
HOST=127.0.0.1
APP_URL=http://localhost:3000

# Frontend
FRONTEND_ORIGIN=http://localhost:3000
VITE_API_URL=/api

# MinIO (local object storage) - change defaults before any real use
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_SECRET_KEY=CHANGE_ME_MINIO_SECRET_KEY
MINIO_BUCKET=campus-materials

# RabbitMQ (local Docker RabbitMQ) - change defaults before any real use
RABBITMQ_URL=amqp://campus:campus@localhost:5672

# Demo seed password (used only by npm run migrate to create demo accounts).
# Must be at least 12 characters with mixed case, digits, and symbols.
DEMO_SEED_PASSWORD=ChangeThisDemoPassword123!

# Qdrant / AI tutor (optional - disable AI features if not configured)
QDRANT_URL=http://localhost:6333
EMBEDDING_MODEL=text-embedding-3-small
DEEPSEEK_BASE_URL=http://localhost:4981/openai/v1
DEEPSEEK_API_KEY=not-needed
